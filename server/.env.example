# ---------------------------------------------------------------------------
# AARAVA BOUTIQUE — SERVER ENVIRONMENT
# Copy to `.env` and fill in real values. Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------------
# Point this at any MongoDB instance (local mongod, Docker, or Atlas).
# Atlas example:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aarava?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/aarava

# --- Auth ------------------------------------------------------------------
# Use long random strings in production, e.g. `openssl rand -hex 48`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- URLs ------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Comma-separated list of additional allowed CORS origins
CORS_EXTRA_ORIGINS=

# --- Payments (Razorpay) ---------------------------------------------------
# The key id is safe to expose to the browser; the secret must stay server-side.
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=rzp_test_xxxxxxxxxxxxx
PAYMENT_KEY_SECRET=replace_with_razorpay_key_secret
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret

# --- Seeded admin account --------------------------------------------------
SEED_ADMIN_EMAIL=admin@aarava.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=priya@example.com
SEED_CUSTOMER_PASSWORD=Customer@123

# --- Storefront contact / integrations -------------------------------------
WHATSAPP_NUMBER=919876543210
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_EMBED_QUERY=Aarava Boutique, Surat, Gujarat

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40
